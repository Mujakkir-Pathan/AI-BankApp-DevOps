# Keep the build context small and reproducible — the Dockerfile does
# `COPY . .` before `./mvnw clean package`, so only the Maven build inputs
# actually need to be inside the context.
.git
.github
.gitignore
target/
*.md

# IDE / editor
.idea/
.vscode/
*.iml
*.ipr
*.iws

# DevOps assets are never needed to build the jar
terraform/
k8s/
helm-chart/
argocd/
setup-k8s/
screenshots/
config/
scripts/
ansible/
init/
.git*
docker-compose.yml
sonar-project.properties
mvnw.cmd
